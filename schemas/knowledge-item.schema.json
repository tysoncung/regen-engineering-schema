{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regen.engineering/schemas/0.1/knowledge-item.schema.json",
  "title": "Regen Engineering knowledge item frontmatter",
  "description": "YAML frontmatter of a single knowledge item file (business rule, decision, contract, assumption, or non-functional requirement).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(BR|ADR|CT|NFR|ASM|RISK|ISS)-[0-9]{3,}$",
      "description": "Unique across the whole repository. Prefix must match type."
    },
    "type": {
      "enum": [
        "business-rule",
        "decision",
        "contract",
        "assumption",
        "nfr",
        "risk",
        "issue"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "resolved",
        "deprecated",
        "superseded"
      ],
      "description": "Lifecycle state. draft: written but not agreed. active: agreed and current. resolved: the problem it described no longer exists, for issues and risks only. deprecated: still described here but no longer the way forward, which for an issue means will-not-fix rather than fixed. superseded: replaced by another item, which must point back via supersedes and must itself be active."
    },
    "since": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Module names whose behaviour depends on this item. The regeneration blast radius."
    },
    "implemented_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Module names containing the implementation."
    },
    "verified_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CT-[0-9]{3,}$"
      },
      "uniqueItems": true,
      "description": "Contract IDs that verify this item."
    },
    "verifies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(BR|NFR)-[0-9]{3,}$"
      },
      "uniqueItems": true,
      "minItems": 1,
      "description": "Items this contract verifies. Contracts only, and required there."
    },
    "supersedes": {
      "type": "string",
      "pattern": "^(BR|ADR|CT|NFR|ASM|RISK|ISS)-[0-9]{3,}$"
    },
    "likelihood": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Risks only."
    },
    "impact": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Risks only."
    },
    "mitigation": {
      "type": "string",
      "minLength": 1,
      "description": "Risks only. One line; the body carries the detail."
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Issues only. Who is dealing with it."
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Free-form dependency names: modules, external services, libraries, teams. Deliberately not validated against the module list, because the important dependencies are outside the repository."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "business-rule"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^BR-"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decision"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^ADR-"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "contract"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "verifies"
        ],
        "properties": {
          "id": {
            "pattern": "^CT-"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "nfr"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^NFR-"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "assumption"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^ASM-"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "description": "A superseded item should say nothing about what replaced it; the replacement points back via supersedes."
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "risk"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^RISK-"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "issue"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^ISS-"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "likelihood": {}
        },
        "required": [
          "likelihood"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "const": "risk"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "owner": {}
        },
        "required": [
          "owner"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "const": "issue"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "resolved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "enum": [
              "issue",
              "risk"
            ]
          }
        },
        "description": "Only an issue or a risk can be resolved. A rule or a decision that no longer applies is deprecated or superseded; it was never a problem to solve."
      }
    }
  ]
}
