{
  "name": "regen-engineering-schema",
  "version": "0.3.1",
  "description": "Knowledge schema and reference validator for Regen Engineering",
  "type": "module",
  "license": "MIT",
  "bin": {
    "regen-validate": "./tools/validate.mjs",
    "regen-impact": "./tools/impact.mjs",
    "regen-debt": "./tools/debt.mjs",
    "regen-drift": "./tools/drift.mjs",
    "regen-test": "./tools/regen-test.mjs",
    "regen-graph": "./tools/graph.mjs",
    "regen-docs": "./tools/docs.mjs"
  },
  "scripts": {
    "validate": "node tools/validate.mjs",
    "impact": "node tools/impact.mjs",
    "debt": "node tools/debt.mjs",
    "drift": "node tools/drift.mjs",
    "test": "node tools/test.mjs",
    "graph": "node tools/graph.mjs",
    "regen-test": "node tools/regen-test.mjs",
    "docs": "node tools/docs.mjs"
